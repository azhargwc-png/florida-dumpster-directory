---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CallButton from '../../components/CallButton.astro';
import { PHONE } from '../../config';
import { CITY_META } from '../../data/cities';
import { isPublished } from '../../lib/utils';

const cities = await getCollection('cities');
const published = cities.filter(e => isPublished(e.data));

// Group by county using CITY_META
const byCounty: Record<string, Array<{ id: string; name: string; url: string }>> = {};
for (const entry of published) {
  const meta = CITY_META[entry.id];
  if (!meta) continue;
  const county = meta.county;
  if (!byCounty[county]) byCounty[county] = [];
  byCounty[county].push({ id: entry.id, name: meta.name, url: entry.data.url });
}

const countyOrder = [
  'Lee County', 'Collier County', 'Charlotte County', 'Sarasota County',
  'DeSoto County', 'Hendry County',
];
const sortedCounties = countyOrder.filter(c => byCounty[c]);
---
<Layout
  title="Dumpster Rental Locations in Southwest Florida | Florida Dumpster Directory"
  description={`Find dumpster rental companies in 23 Southwest Florida cities across Lee, Collier, Charlotte, Sarasota, DeSoto and Hendry counties. Call ${PHONE}.`}
  pageUrl="/locations/"
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Locations', path: '/locations/' }]}
  areaServed={published.map(e => CITY_META[e.id]?.name).filter(Boolean) as string[]}
>
  <Breadcrumb items={[{ name: 'Home', path: '/' }, { name: 'Locations' }]} />

  <div style="background:linear-gradient(160deg,#12284B 0%,#1B3765 100%);color:#fff;padding:52px 0 44px">
    <div class="wrap">
      <div style="font-size:13px;font-weight:600;color:#F89B5E;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:12px">Directory · All Locations</div>
      <h1 style="color:#fff;font-weight:700;font-size:38px;margin:0 0 14px">Dumpster Rental by City, Southwest Florida</h1>
      <p style="color:#C7D5EA;font-size:18px;margin:0 0 24px;max-width:680px">{published.length} cities across 6 counties. Each page lists the local dumpster companies serving that city with their real Google review counts.</p>
      <CallButton size="md" />
    </div>
  </div>

  <div class="wrap" style="padding-top:52px;padding-bottom:64px">
    <div style="display:flex;flex-direction:column;gap:40px">
      {sortedCounties.map((county, ci) => (
        <div>
          <h2 style={`font-size:22px;font-weight:700;color:var(--navy);margin:0 0 16px;padding-bottom:10px;border-bottom:2px solid ${ci % 2 === 0 ? '#F26A1B' : '#1E7FC2'}`}>{county}</h2>
          <div style="display:flex;flex-wrap:wrap;gap:10px">
            {byCounty[county].map(city => (
              <a
                href={city.url}
                style="display:inline-block;padding:10px 20px;background:#fff;border:1px solid var(--line);border-radius:999px;font-size:15px;font-weight:500;color:var(--navy);text-decoration:none"
              >
                {city.name}
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div style="margin-top:48px;padding:28px;background:var(--navy);border-radius:16px;color:#fff">
      <h2 style="color:#fff;font-weight:700;font-size:20px;margin:0 0 10px">Not seeing your city?</h2>
      <p style="color:#C7D5EA;margin:0 0 18px">The directory covers {published.length} cities and is growing. Call {PHONE} to reach a local dumpster company in your area.</p>
      <CallButton size="sm" />
    </div>
  </div>
</Layout>
