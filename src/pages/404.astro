---
import Layout from '../layouts/Layout.astro';
import CallButton from '../components/CallButton.astro';
import { PHONE } from '../config';
---
<Layout
  title="Page Not Found | Florida Dumpster Directory"
  description="The page you're looking for doesn't exist. Find dumpster rental companies in Southwest Florida by browsing cities or calling us."
  pageUrl="/404/"
>
  <div style="min-height:60vh;display:flex;align-items:center;justify-content:center;padding:64px 20px;text-align:center">
    <div>
      <div style="font-size:80px;font-weight:700;color:var(--orange);line-height:1;margin-bottom:16px">404</div>
      <h1 style="font-size:28px;font-weight:700;color:var(--navy);margin:0 0 12px">Page Not Found</h1>
      <p style="font-size:17px;color:var(--muted);margin:0 0 28px;max-width:400px">That page doesn't exist. Browse the directory by city or call {PHONE} to reach a local dumpster company.</p>
      <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center">
        <CallButton size="md" />
        <a href="/locations/" style="display:inline-flex;align-items:center;padding:0 24px;height:48px;background:#fff;border:1px solid var(--line);border-radius:9999px;font-size:16px;font-weight:600;color:var(--navy);text-decoration:none">Browse Locations →</a>
      </div>
    </div>
  </div>
</Layout>
