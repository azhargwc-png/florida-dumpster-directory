---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Prose from '../../components/Prose.astro';
import CallButton from '../../components/CallButton.astro';
import { PHONE } from '../../config';

const entries = await getCollection('legal');
const entry = entries.find(e => e.id === 'contact');
if (!entry) throw new Error('contact.md not found');
const { data } = entry;
const { Content } = await render(entry);
---
<Layout
  title={data.seo_title}
  description={data.meta_description.replace('[PHONE]', PHONE)}
  pageUrl={data.url}
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact/' }]}
>
  <Breadcrumb items={[{ name: 'Home', path: '/' }, { name: 'Contact' }]} />
  <div class="wrap-article" style="padding-top:52px;padding-bottom:72px">
    <h1 style="font-size:38px;font-weight:700;margin:0 0 32px">{data.h1}</h1>
    <div style="background:var(--navy);border-radius:16px;padding:32px;color:#fff;margin-bottom:40px">
      <p style="color:#C7D5EA;font-size:18px;margin:0 0 20px">Florida Dumpster Directory is a call-only service. The number below connects you with a local dumpster rental company serving your Southwest Florida city.</p>
      <CallButton size="lg" />
    </div>
    <Prose><Content /></Prose>
  </div>
</Layout>
