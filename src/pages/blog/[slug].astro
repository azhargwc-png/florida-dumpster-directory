---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Prose from '../../components/Prose.astro';
import CallButton from '../../components/CallButton.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import { PHONE } from '../../config';
import { isPublished, extractFAQ } from '../../lib/utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter(e => isPublished(e.data))
    .map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const faqs = extractFAQ(entry.body ?? '');
const heroImg = `/${entry.id}.webp`;
const hasImg = true; // webp images were included for all blog posts
---
<Layout
  title={data.seo_title.replace('[PHONE]', PHONE)}
  description={data.meta_description.replace('[PHONE]', PHONE)}
  pageUrl={data.url}
  faq={faqs}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Blog', path: '/blog/' },
    { name: data.h1, path: data.url },
  ]}
  article={{ headline: data.h1 }}
  image={heroImg}
  pubDate={data.pubDate}
  ogType="article"
>
  <Breadcrumb items={[
    { name: 'Home', path: '/' },
    { name: 'Blog', path: '/blog/' },
    { name: data.h1 },
  ]} />

  <!-- Article header -->
  <section class="post-header">
    <div class="wrap-article">
      {data.pubDate && (
        <div class="post-date">
          {data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
        </div>
      )}
      <h1>{data.h1}</h1>
    </div>
  </section>

  <!-- Lead image (hides itself if the webp doesn't exist) -->
  <div class="post-lead-img">
    <img src={heroImg} alt={data.h1} loading="eager" decoding="async"
      onerror="this.closest('.post-lead-img').style.display='none'" />
  </div>

  <!-- Content + sidebar -->
  <div class="wrap post-body">
    <div class="post-content">
      <Prose><Content /></Prose>
    </div>
    <aside class="post-sidebar">
      <div class="sidebar-cta">
        <div class="sidebar-cta__head">Reach a Local Dumpster Company</div>
        <p>Call to get connected with a hauler serving your Southwest Florida city.</p>
        <CallButton size="sm" />
      </div>
      <div class="sidebar-links">
        <div class="sidebar-links__head">Helpful Links</div>
        <a href="/tools/dumpster-size-calculator/">→ Dumpster size calculator</a>
        <a href="/dumpster-sizes/">→ Compare all sizes</a>
        <a href="/locations/">→ Browse cities</a>
        <a href="/blog/">← Back to blog</a>
      </div>
    </aside>
  </div>

  <ClosingCta
    heading="Call Now to Reach a Local Dumpster Company"
    body={`Call ${PHONE} to get connected with a dumpster rental company in your Southwest Florida city.`}
    narrow={true}
  />
</Layout>

<style>
  /* ---- Article header ---- */
  .post-header {
    background: var(--navy);
    padding: 44px 0 40px;
  }
  .post-header .wrap-article { width: 100%; }
  .post-date {
    font-size: 12px;
    font-weight: 700;
    color: var(--amber);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 14px;
  }
  .post-header h1 {
    color: #fff;
    font-size: 36px;
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
    text-wrap: pretty;
  }
  @media (max-width: 640px) {
    .post-header { padding: 28px 0 24px; }
    .post-header h1 { font-size: 26px; }
  }

  /* ---- Lead image ---- */
  .post-lead-img {
    width: 100%;
    overflow: hidden;
    max-height: 480px;
    background: var(--navy);
  }
  .post-lead-img img {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
    display: block;
  }

  .post-body {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 48px;
    align-items: start;
    padding-top: 52px;
    padding-bottom: 64px;
  }
  .post-content { min-width: 0; }
  .post-sidebar { min-width: 0; align-self: start; position: sticky; top: 88px; }
  @media (max-width: 860px) {
    .post-body { grid-template-columns: 1fr; }
    .post-sidebar { position: static; order: -1; }
  }

  .sidebar-cta {
    background: var(--navy);
    border-radius: 14px;
    padding: 24px;
    color: #fff;
    margin-bottom: 18px;
  }
  .sidebar-cta__head {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 17px;
    margin-bottom: 8px;
  }
  .sidebar-cta p {
    font-size: 14px;
    color: #C7D5EA;
    margin: 0 0 16px;
    line-height: 1.6;
  }
  .sidebar-links {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 20px;
  }
  .sidebar-links__head {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 14px;
    color: var(--navy);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 12px;
  }
  .sidebar-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .sidebar-links a {
    font-size: 14px;
    font-weight: 500;
    color: var(--blue);
    text-decoration: none;
  }
  .sidebar-links a:hover { text-decoration: underline; }
</style>
