---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { isPublished } from '../../lib/utils';
import { PHONE } from '../../config';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(e => isPublished(e.data))
  .sort((a, b) => {
    const da = a.data.pubDate?.getTime() ?? 0;
    const db = b.data.pubDate?.getTime() ?? 0;
    return db - da;
  });
---
<Layout
  title="Dumpster Rental Blog | Florida Dumpster Directory"
  description={`Guides on dumpster rental in Southwest Florida — sizing, permits, project planning, debris rules, and local tips. Call ${PHONE} to reach a local hauler.`}
  pageUrl="/blog/"
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog/' }]}
>
  <div style="background:linear-gradient(160deg,#12284B 0%,#1B3765 100%);color:#fff;padding:52px 0 44px">
    <div class="wrap">
      <div style="font-size:12px;font-weight:700;color:#F89B5E;text-transform:uppercase;letter-spacing:0.07em;margin-bottom:12px">Blog</div>
      <h1 style="color:#fff;font-weight:700;font-size:38px;margin:0 0 12px">Dumpster Rental Guides</h1>
      <p style="color:#C7D5EA;font-size:18px;margin:0;max-width:640px">Sizing, permits, project planning and Florida-specific debris rules — written for Southwest Florida homeowners and contractors.</p>
    </div>
  </div>

  <div class="wrap" style="padding-top:52px;padding-bottom:72px">
    <div class="blog-grid">
      {posts.map((post) => (
        <a href={post.data.url} class="blog-card">
          <div class="blog-card__img">
            <img src={`/${post.id}.webp`} alt={post.data.h1} loading="lazy" decoding="async"
              onerror="this.style.display='none'" />
          </div>
          <div class="blog-card__body">
            {post.data.pubDate && (
              <div class="blog-card__date">
                {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
              </div>
            )}
            <h2 class="blog-card__title">{post.data.h1}</h2>
            <p class="blog-card__desc">{post.data.meta_description.replace('[PHONE]', PHONE).slice(0, 140)}&hellip;</p>
            <span class="blog-card__cta">Read article →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>

<style>
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr));
    gap: 24px;
  }
  .blog-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    transition: box-shadow 0.15s, transform 0.15s;
  }
  .blog-card:hover {
    box-shadow: 0 8px 28px rgba(18,40,75,0.1);
    transform: translateY(-2px);
  }
  .blog-card__img {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--sand);
  }
  .blog-card__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }
  .blog-card:hover .blog-card__img img { transform: scale(1.03); }
  .blog-card__body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .blog-card__date {
    font-size: 12px;
    font-weight: 600;
    color: var(--muted-2);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
  }
  .blog-card__title {
    font-size: 17px;
    font-weight: 600;
    color: var(--navy);
    margin: 0 0 10px;
    line-height: 1.4;
  }
  .blog-card__desc {
    font-size: 14px;
    color: var(--muted);
    margin: 0 0 16px;
    line-height: 1.6;
    flex: 1;
  }
  .blog-card__cta {
    font-size: 14px;
    font-weight: 600;
    color: var(--blue);
  }
</style>
