---
interface Props { class?: string; }
const { class: cls = '' } = Astro.props;
---
<div class={`prose ${cls}`}>
  <slot />
</div>

<style>
  .prose { color: var(--ink-2); font-size: 17px; line-height: 1.75; }

  .prose :global(h2) {
    font-family: var(--font-head); font-weight: 700; font-size: 24px;
    color: var(--navy); margin: 44px 0 14px; padding-top: 8px;
    border-top: 2px solid var(--line);
  }
  .prose :global(h2:first-child) { margin-top: 0; border-top: none; padding-top: 0; }

  .prose :global(h3) {
    font-family: var(--font-head); font-weight: 600; font-size: 19px;
    color: var(--navy); margin: 28px 0 10px;
  }

  .prose :global(p) { margin: 0 0 20px; }
  .prose :global(p:last-child) { margin-bottom: 0; }

  /* Lists — default */
  .prose :global(ul), .prose :global(ol) {
    margin: 0 0 22px; padding-left: 22px; line-height: 1.9;
  }
  .prose :global(li) { margin-bottom: 6px; }

  /* Company/listing cards — li where first inline element is <strong> */
  .prose :global(ul:has(li > strong:first-child)) {
    padding-left: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .prose :global(ul li:has(> strong:first-child)) {
    background: #fff;
    border: 1px solid var(--line);
    border-left: 4px solid var(--orange);
    border-radius: 10px;
    padding: 14px 18px;
    line-height: 1.6;
  }
  .prose :global(ul li:has(> strong:first-child) > strong:first-child) {
    display: block;
    color: var(--navy);
    font-size: 16px;
    margin-bottom: 2px;
  }

  .prose :global(strong) { color: var(--navy); }
  .prose :global(a) { color: var(--blue); text-decoration: none; font-weight: 500; }
  .prose :global(a:hover) { text-decoration: underline; }
  .prose :global(em) { font-style: italic; color: var(--muted); }

  /* Disclaimer italics */
  .prose :global(p > em:only-child) {
    display: block;
    font-size: 13px;
    color: var(--muted-2);
    margin-top: 8px;
    line-height: 1.6;
  }

  /* Callout blockquote */
  .prose :global(blockquote) {
    background: var(--orange-soft); border: 1px solid var(--orange-border);
    border-left: 5px solid var(--orange); border-radius: var(--radius);
    padding: 18px 22px; margin: 0 0 24px;
  }
  .prose :global(blockquote p) { margin: 0; }

  /* FAQ accordions injected by remark plugin */
  .prose :global(details.faq) {
    background: #fff; border: 1px solid var(--line);
    border-radius: var(--radius); padding: 2px 22px; margin-bottom: 10px;
  }
  .prose :global(details.faq > summary) {
    font-family: var(--font-head); font-weight: 600; color: var(--navy);
    font-size: 17px; padding: 15px 0; cursor: pointer; list-style: none;
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
  }
  .prose :global(details.faq > summary::after) {
    content: '+'; flex-shrink: 0; font-size: 22px; font-weight: 300; color: var(--orange);
  }
  .prose :global(details.faq[open] > summary::after) { content: '−'; }
  .prose :global(details.faq > summary::-webkit-details-marker) { display: none; }
  .prose :global(details.faq > p) { margin: 0 0 14px; color: var(--muted); line-height: 1.7; }

  /* FAQ section wrapper */
  .prose :global(.faq-section) { margin: 32px 0; }
  .prose :global(.faq-section h2) { margin-bottom: 18px; }

  /* Horizontal rule */
  .prose :global(hr) {
    border: none; border-top: 1px solid var(--line); margin: 36px 0;
  }
</style>
