---
import { SITE_NAME, FOOTER_DISCLAIMER, PHONE, PHONE_TEL } from '../config';
const year = new Date().getFullYear();
---
<footer>
  <div class="footer-inner wrap">
    <div class="footer-top">
      <div class="footer-brand">
        <img src="/Logo.png" alt={SITE_NAME} height="44" style="height:44px;width:auto;margin-bottom:14px" />
        <p class="footer-tagline">The Southwest Florida dumpster rental directory. 23 cities · 6 counties.</p>
        <a href={`tel:${PHONE_TEL}`} class="footer-phone">{PHONE}</a>
      </div>

      <div class="footer-col">
        <div class="footer-col-head">Services</div>
        <a href="/roll-off-dumpster-rental/">Roll-off Rental</a>
        <a href="/roofing-dumpster-rental/">Roofing</a>
        <a href="/construction-dumpster-rental/">Construction</a>
        <a href="/concrete-dumpster-rental/">Concrete &amp; Heavy Debris</a>
        <a href="/demolition-dumpster-rental/">Demolition</a>
        <a href="/yard-waste-dumpster-rental/">Yard Waste</a>
      </div>

      <div class="footer-col">
        <div class="footer-col-head">Sizes</div>
        <a href="/10-yard-dumpster-rental/">10-Yard Dumpster</a>
        <a href="/15-yard-dumpster-rental/">15-Yard Dumpster</a>
        <a href="/20-yard-dumpster-rental/">20-Yard Dumpster</a>
        <a href="/30-yard-dumpster-rental/">30-Yard Dumpster</a>
        <a href="/40-yard-dumpster-rental/">40-Yard Dumpster</a>
      </div>

      <div class="footer-col">
        <div class="footer-col-head">Directory</div>
        <a href="/locations/">All Locations</a>
        <a href="/dumpster-sizes/">Dumpster Sizes</a>
        <a href="/blog/">Blog</a>
        <a href="/tools/">Tools</a>
        <div class="footer-col-head" style="margin-top:18px">Company</div>
        <a href="/about/">About</a>
        <a href="/contact/">Contact</a>
        <a href="/privacy-policy/">Privacy Policy</a>
        <a href="/terms/">Terms</a>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-disclaimer">{FOOTER_DISCLAIMER}</p>
      <p class="footer-copy">© {year} {SITE_NAME}</p>
    </div>
  </div>
</footer>

<style>
  footer {
    background: var(--navy-deep);
    color: #93A4C0;
    margin-top: auto;
  }
  .footer-inner {
    padding-top: 56px;
    padding-bottom: 48px;
  }
  .footer-top {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 40px;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    margin-bottom: 28px;
  }
  @media (max-width: 860px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 540px) {
    .footer-top {
      grid-template-columns: 1fr;
    }
  }
  .footer-brand .footer-tagline {
    font-size: 14px;
    color: #7E90AD;
    line-height: 1.6;
    margin: 0 0 14px;
    max-width: 260px;
  }
  .footer-phone {
    display: inline-block;
    color: #F89B5E;
    font-weight: 700;
    font-size: 17px;
    text-decoration: none;
  }
  .footer-phone:hover { color: #fff; }
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .footer-col-head {
    font-size: 11px;
    font-weight: 700;
    color: #5E7194;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 4px;
  }
  .footer-col a {
    font-size: 14px;
    color: #93A4C0;
    text-decoration: none;
    line-height: 1.4;
  }
  .footer-col a:hover { color: #fff; }
  .footer-disclaimer {
    font-size: 12px;
    line-height: 1.7;
    color: #5E7194;
    max-width: 900px;
    margin: 0 0 10px;
  }
  .footer-copy {
    font-size: 12px;
    color: #4A5A70;
    margin: 0;
  }
</style>
