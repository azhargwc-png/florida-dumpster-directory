---
import { SITE_NAME, FOOTER_DISCLAIMER, PHONE, PHONE_TEL } from '../config';
const year = new Date().getFullYear();
---
<footer style="background:var(--navy-deep);color:#93A4C0">
  <div class="wrap" style="padding-top:48px;padding-bottom:80px">
    <img src="/Logo.png" alt={SITE_NAME} height="48" style="height:48px;width:auto;margin-bottom:20px" />
    <div style="display:flex;flex-wrap:wrap;gap:40px;margin-bottom:28px">
      <div>
        <div style="font-size:13px;font-weight:600;color:#7E90AD;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:10px">Services</div>
        <div style="display:flex;flex-direction:column;gap:6px;font-size:14px">
          <a href="/roll-off-dumpster-rental/" style="color:#93A4C0;text-decoration:none">Roll-off Rental</a>
          <a href="/roofing-dumpster-rental/" style="color:#93A4C0;text-decoration:none">Roofing</a>
          <a href="/construction-dumpster-rental/" style="color:#93A4C0;text-decoration:none">Construction</a>
          <a href="/concrete-dumpster-rental/" style="color:#93A4C0;text-decoration:none">Concrete & Heavy Debris</a>
          <a href="/demolition-dumpster-rental/" style="color:#93A4C0;text-decoration:none">Demolition</a>
          <a href="/yard-waste-dumpster-rental/" style="color:#93A4C0;text-decoration:none">Yard Waste</a>
        </div>
      </div>
      <div>
        <div style="font-size:13px;font-weight:600;color:#7E90AD;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:10px">Sizes</div>
        <div style="display:flex;flex-direction:column;gap:6px;font-size:14px">
          <a href="/10-yard-dumpster-rental/" style="color:#93A4C0;text-decoration:none">10-Yard</a>
          <a href="/15-yard-dumpster-rental/" style="color:#93A4C0;text-decoration:none">15-Yard</a>
          <a href="/20-yard-dumpster-rental/" style="color:#93A4C0;text-decoration:none">20-Yard</a>
          <a href="/30-yard-dumpster-rental/" style="color:#93A4C0;text-decoration:none">30-Yard</a>
          <a href="/40-yard-dumpster-rental/" style="color:#93A4C0;text-decoration:none">40-Yard</a>
        </div>
      </div>
      <div>
        <div style="font-size:13px;font-weight:600;color:#7E90AD;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:10px">Directory</div>
        <div style="display:flex;flex-direction:column;gap:6px;font-size:14px">
          <a href="/locations/" style="color:#93A4C0;text-decoration:none">All Locations</a>
          <a href="/dumpster-sizes/" style="color:#93A4C0;text-decoration:none">Dumpster Sizes</a>
          <a href="/blog/" style="color:#93A4C0;text-decoration:none">Blog</a>
          <a href="/tools/" style="color:#93A4C0;text-decoration:none">Tools</a>
        </div>
      </div>
      <div>
        <div style="font-size:13px;font-weight:600;color:#7E90AD;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:10px">Company</div>
        <div style="display:flex;flex-direction:column;gap:6px;font-size:14px">
          <a href="/about/" style="color:#93A4C0;text-decoration:none">About</a>
          <a href="/contact/" style="color:#93A4C0;text-decoration:none">Contact</a>
          <a href="/privacy-policy/" style="color:#93A4C0;text-decoration:none">Privacy Policy</a>
          <a href="/terms/" style="color:#93A4C0;text-decoration:none">Terms</a>
          <a href={`tel:${PHONE_TEL}`} style="color:#F89B5E;font-weight:600;text-decoration:none">{PHONE}</a>
        </div>
      </div>
    </div>
    <p style="font-size:13px;line-height:1.7;margin:0;max-width:820px;color:#7E90AD">{FOOTER_DISCLAIMER}</p>
    <p style="font-size:13px;margin:16px 0 0;color:#5E7194">© {year} {SITE_NAME}</p>
  </div>
</footer>
